{
  "id": "tpl-secrets-scan",
  "name": "Secrets Scan",
  "description": "Scan repository for hardcoded secrets, API keys and tokens.",
  "author": "OGMOP",
  "tags": ["secrets", "security", "quick"],
  "category": "security",
  "version": "1.0.0",
  "isPublic": true,
  "createdAt": "2026-01-01T00:00:00.000Z",
  "updatedAt": "2026-01-01T00:00:00.000Z",
  "usageCount": 0,
  "workflow": {
    "name": "Secrets Scan",
    "description": "Manual trigger -> secrets scan -> AI analysis -> webhook",
    "nodes": [
      { "id": "n1", "type": "trigger.manual", "position": { "x": 50, "y": 100 }, "data": { "kind": "trigger", "triggerType": "manual", "label": "Start" } },
      { "id": "n2", "type": "scanner.secrets", "position": { "x": 260, "y": 100 }, "data": { "kind": "scanner", "scannerType": "secrets", "label": "Secrets scan", "config": { "scannerType": "secrets", "targetPath": "./demo-repo", "includePatterns": ["**/*.kt", "**/*.kts", "**/*.properties", "**/*.yml"] } } },
      { "id": "n3", "type": "ai.analyze", "position": { "x": 470, "y": 100 }, "data": { "kind": "ai", "label": "AI report", "provider": "openai", "model": "gpt-4o-mini", "prompt": "Summarize secret findings." } },
      { "id": "n4", "type": "notify.webhook", "position": { "x": 680, "y": 100 }, "data": { "kind": "notify", "channel": "webhook", "label": "Send report", "config": { "channel": "webhook", "url": "https://example.com/webhook", "method": "POST" } } }
    ],
    "edges": [
      { "id": "e1", "source": "n1", "target": "n2" },
      { "id": "e2", "source": "n2", "target": "n3" },
      { "id": "e3", "source": "n3", "target": "n4" }
    ]
  }
}
    "name": "SCA Dependency Check",
    "description": "Manual trigger -> SCA scan -> AI analysis -> email",
    "nodes": [
      { "id": "n1", "type": "trigger.manual", "position": { "x": 50, "y": 100 }, "data": { "kind": "trigger", "triggerType": "manual", "label": "Start" } },
      { "id": "n2", "type": "scanner.sca", "position": { "x": 260, "y": 100 }, "data": { "kind": "scanner", "scannerType": "sca", "label": "Dependency check", "config": { "scannerType": "sca", "targetPath": "./demo-repo" } } },
      { "id": "n3", "type": "ai.analyze", "position": { "x": 470, "y": 100 }, "data": { "kind": "ai", "label": "AI report", "provider": "openai", "model": "gpt-4o-mini", "prompt": "Summarize dependency vulnerabilities." } },
      { "id": "n4", "type": "notify.smtp", "position": { "x": 680, "y": 100 }, "data": { "kind": "notify", "channel": "smtp", "label": "Email report", "config": { "channel": "smtp", "host": "smtp.example.com", "port": 587, "from": "ogmop@example.com", "to": ["dev@example.com"], "subject": "OGMOP SCA report" } } }
    ],
    "edges": [
      { "id": "e1", "source": "n1", "target": "n2" },
      { "id": "e2", "source": "n2", "target": "n3" },
      { "id": "e3", "source": "n3", "target": "n4" }
    ]
  }

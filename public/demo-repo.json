{"files":{"Application.kt":"package com.example.demo\n\nimport org.springframework.boot.autoconfigure.SpringBootApplication\nimport org.springframework.boot.runApplication\n\n@SpringBootApplication\nclass Application\n\nfun main(args: Array<String>) {\n    runApplication<Application>(*args)\n}","application.properties":"app.password=changeme\napp.secretToken=token-12345\ndb.password=SuperSecret123!\napi.key=sk-live-9999","AwsClient.kt":"package com.example.demo.cloud\n\nclass AwsClient {\n    // AWS-like access key hardcoded\n    private val awsAccessKey = \"AKIAIOSFODNN7EXAMPLE\"\n    private val awsSecretKey = \"wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY\"\n\n    fun token(): String = \"ghp_abcdefghijklmnopqrstuvwxyz0123456789\"\n\n    fun apiKey(): String = \"api_key=abcdefghijklmnopqrstuvwxyz123456\"\n}","build.gradle.kts":"plugins {\n    kotlin(\"jvm\") version \"1.9.24\"\n    kotlin(\"plugin.spring\") version \"1.9.24\"\n    id(\"org.springframework.boot\") version \"3.2.0\"\n    id(\"io.spring.dependency-management\") version \"1.1.4\"\n}\n\ngroup = \"com.example\"\nversion = \"0.0.1-SNAPSHOT\"\n\njava {\n    sourceCompatibility = JavaVersion.VERSION_17\n}\n\nrepositories {\n    mavenCentral()\n}\n\ndependencies {\n    implementation(\"org.springframework.boot:spring-boot-starter-web\")\n    implementation(\"org.springframework.boot:spring-boot-starter-data-jpa\")\n    implementation(\"org.springframework:spring-beans:5.3.10\")\n    implementation(\"org.springframework:spring-expression:5.3.10\")\n    implementation(\"org.springframework.security:spring-security-core:5.4.2\")\n    implementation(\"com.fasterxml.jackson.core:jackson-databind:2.12.3\")\n    implementation(\"io.netty:netty-codec:4.1.60\")\n    implementation(\"io.netty:netty-handler:4.1.50\")\n    implementation(\"org.yaml:snakeyaml:1.29\")\n    implementation(\"org.json:json:20220320\")\n    implementation(\"com.google.protobuf:protobuf-java:3.15.0\")\n    runtimeOnly(\"org.postgresql:postgresql:42.3.1\")\n    testImplementation(\"org.springframework.boot:spring-boot-starter-test\")\n}\n\ntasks.withType<org.jetbrains.kotlin.gradle.tasks.KotlinCompile> {\n    kotlinOptions {\n        freeCompilerArgs += \"-Xjsr305=strict\"\n        jvmTarget = \"17\"\n    }\n}","Config.kt":"package com.example.demo.config\n\nimport org.springframework.context.annotation.Configuration\n\n@Configuration\nclass Config {\n    // Hardcoded credentials (should be externalized)\n    val dbPassword = \"SuperSecret123!\"\n    val apiKey = \"sk-live-1234567890abcdef\"\n    val jwtSecret = \"jwt-secret-key-do-not-share\"\n\n    fun getConnectionString(): String {\n        return \"jdbc:postgresql://localhost:5432/app?user=admin&password=$dbPassword\"\n    }\n}","JwtUtil.kt":"package com.example.demo.security\n\nclass JwtUtil {\n    // Hardcoded JWT secret\n    private val jwtSecret = \"super-secret-jwt-key-1234567890\"\n\n    fun createToken(role: String): String {\n        // Weak role comparison\n        if (role == \"root\") {\n            return \"admin-token\"\n        }\n        return \"user-token\"\n    }\n\n    fun isWeak(role: String): Boolean = role == \"admin\" || role == \"ADMIN\"\n}","PaymentController.kt":"package com.example.demo.payment\n\nimport org.springframework.web.bind.annotation.*\nimport java.sql.Connection\nimport java.sql.DriverManager\n\n@RestController\nclass PaymentController {\n\n    // Hardcoded credentials (should be externalized)\n    private val dbPassword = \"PaymentSecret999!\"\n\n    @GetMapping(\"/payments\")\n    fun findPayments(@RequestParam userId: String): String {\n        val conn: Connection = DriverManager.getConnection(\"jdbc:postgresql://localhost/payments\", \"admin\", \"admin123\")\n        // SQL injection via string concatenation\n        val query = \"SELECT * FROM payments WHERE user_id = '\" + userId + \"'\"\n        val stmt = conn.createStatement()\n        val rs = stmt.executeQuery(query)\n        return if (rs.next()) rs.getString(\"amount\") else \"not found\"\n    }\n\n    fun endpoint(): String = \"http://example.com/payments\"\n}","Properties.kt":"package com.example.demo\n\nimport org.springframework.boot.context.properties.ConfigurationProperties\n\n@ConfigurationProperties(prefix = \"app\")\nclass AppProperties {\n    var password: String = \"changeme\"\n    var secretToken: String = \"token-12345\"\n}","Repository.kt":"package com.example.demo.repository\n\nimport org.springframework.data.jpa.repository.JpaRepository\nimport org.springframework.stereotype.Repository\n\n@Repository\ninterface UserRepository : JpaRepository<Any, Long> {\n    // Derived query is fine, but raw eval below is not\n    fun findByEmail(email: String): List<Any>\n}\n\nfun dangerousEval(input: String): Any? {\n    // Using reflection to execute arbitrary code\n    return Class.forName(input).getDeclaredConstructor().newInstance()\n}","SecurityConfig.kt":"package com.example.demo.security\n\nimport org.springframework.context.annotation.Bean\nimport org.springframework.context.annotation.Configuration\nimport org.springframework.security.config.annotation.web.builders.HttpSecurity\nimport org.springframework.security.web.SecurityFilterChain\n\n@Configuration\nclass SecurityConfig {\n    @Bean\n    fun filterChain(http: HttpSecurity): SecurityFilterChain {\n        http.authorizeHttpRequests { it.anyRequest().permitAll() }\n        http.csrf { it.disable() }\n        return http.build()\n    }\n}","UserController.kt":"package com.example.demo.controller\n\nimport org.springframework.web.bind.annotation.GetMapping\nimport org.springframework.web.bind.annotation.RequestParam\nimport org.springframework.web.bind.annotation.RestController\nimport java.sql.Connection\nimport java.sql.DriverManager\n\n@RestController\nclass UserController {\n\n    @GetMapping(\"/users\")\n    fun findUser(@RequestParam name: String): String {\n        val conn: Connection = DriverManager.getConnection(\"jdbc:postgresql://localhost/db\", \"admin\", \"admin123\")\n        // SQL injection via string concatenation\n        val query = \"SELECT * FROM users WHERE name = '\" + name + \"'\"\n        val stmt = conn.createStatement()\n        val rs = stmt.executeQuery(query)\n        return if (rs.next()) rs.getString(\"name\") else \"not found\"\n    }\n}","UserService.kt":"package com.example.demo.service\n\nimport org.springframework.stereotype.Service\n\n@Service\nclass UserService {\n    // AWS-like access key hardcoded\n    private val awsAccessKey = \"AKIAIOSFODNN7EXAMPLE\"\n    private val awsSecretKey = \"wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY\"\n\n    fun token(): String = \"ghp_abcdefghijklmnopqrstuvwxyz0123456789\"\n\n    fun isAdmin(role: String): Boolean {\n        // Weak comparison / logic error\n        return role == \"admin\" || role == \"ADMIN\" || role == \"root\"\n    }\n}"},"cve":[{"id":"CVE-2022-22965","package":"org.springframework:spring-beans","ecosystem":"maven","affectedVersions":">=5.3.0 <5.3.18","fixedVersion":"5.3.18","severity":"critical","title":"Spring4Shell RCE","description":"Remote code execution via data binding on JDK 9+."},{"id":"CVE-2022-22963","package":"org.springframework.cloud:spring-cloud-function-context","ecosystem":"maven","affectedVersions":">=3.1.0 <3.1.7","fixedVersion":"3.1.7","severity":"critical","title":"Spring Cloud Function SpEL injection","description":"SpEL injection leading to RCE."},{"id":"CVE-2021-22118","package":"org.springframework.security:spring-security-core","ecosystem":"maven","affectedVersions":">=5.2.0 <5.4.6","fixedVersion":"5.4.6","severity":"high","title":"Authorization bypass","description":"Authorization bypass in Spring Security."},{"id":"CVE-2020-5408","package":"org.springframework.security:spring-security-web","ecosystem":"maven","affectedVersions":">=5.2.0 <5.2.4","fixedVersion":"5.2.4","severity":"medium","title":"Reflected file download","description":"Reflected file download vulnerability."},{"id":"CVE-2022-